# Caddy reverse proxy for the mock HR system.
#
# Single external ingress on :8080 (Azure Container Apps terminates TLS and
# forwards HTTP here). Routes:
#   /mcp-docs, /mcp-docs/*  -> API/web console (the human-readable MCP reference)
#   /mcp, /mcp/*            -> MCP server (streamable HTTP, needs unbuffered streaming)
#   everything else         -> API/web console
#
# /mcp-docs is matched FIRST and explicitly: it is a console page served by the
# api container and must never be swallowed by the MCP transport route.
#
# Upstreams default to localhost (all containers share one network namespace
# inside an ACA replica). For docker-compose they are overridden via env to the
# service names (api:8000 / mcp:8001).
{
	admin off
	auto_https off
	servers {
		# The ACA ingress terminates TLS and forwards over Azure-managed
		# infrastructure with X-Forwarded-Proto set from the real client
		# connection. Its source IPs are dynamic and are NOT in Caddy's
		# private_ranges, so trust every peer: this container is only ever
		# reachable through that ingress, and the header only feeds the origin
		# printed on the docs page.
		trusted_proxies static 0.0.0.0/0 ::/0
	}
}

:8080 {
	@mcpdocs path /mcp-docs /mcp-docs/*
	handle @mcpdocs {
		reverse_proxy {$API_UPSTREAM:localhost:8000}
	}

	@mcp path /mcp /mcp/*
	handle @mcp {
		reverse_proxy {$MCP_UPSTREAM:localhost:8001} {
			# Disable response buffering so SSE / streamable-HTTP flushes promptly.
			flush_interval -1
		}
	}

	handle {
		reverse_proxy {$API_UPSTREAM:localhost:8000}
	}
}
